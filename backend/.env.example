# ==========================
# Gemini
# ==========================
GEMINI_API_KEY=your_gemini_api_key

# ==========================
# Qdrant
# ==========================
QDRANT_URL=https://your-cluster-url
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=contextify

# ==========================
# Embedding Provider
# ==========================
EMBEDDING_API_KEY=your_embedding_api_key
EMBEDDING_MODEL=bge-m3

# ==========================
# Application
# ==========================
APP_ENV=development
LOG_LEVEL=INFO