{
  "manifest_version": 3,
  "name": "Contextify",
  "version": "1.0.0",
  "description": "AI-powered browser assistant for indexing webpages and YouTube videos.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Contextify"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "permissions": [
    "activeTab"
  ],

  "host_permissions": [
    "http://localhost:8000/*"
  ]
}